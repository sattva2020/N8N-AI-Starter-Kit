# rStar2-Agent Configuration
# Configuration file for rStar2-Agent service

# Model Configuration
RSTAR_MODEL_NAME=microsoft/rStar2-Agent-14B
RSTAR_MODEL_PATH=/app/models
RSTAR_MAX_TOKENS=2048
RSTAR_TEMPERATURE=0.7

# VLLM Server Configuration
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_GPU_MEMORY_UTILIZATION=0.8
VLLM_MAX_MODEL_LEN=4096
VLLM_TENSOR_PARALLEL_SIZE=1

# Code Judge Configuration
CODE_JUDGE_HOST=0.0.0.0
CODE_JUDGE_PORT=8088
CODE_JUDGE_TIMEOUT=30
CODE_JUDGE_MAX_MEMORY=512m
CODE_JUDGE_MAX_CPU=1.0

# Worker Configuration
WORKER_COUNT=2
WORKER_CONCURRENCY=4
WORKER_TIMEOUT=300
WORKER_RETRY_ATTEMPTS=3

# Redis Configuration
REDIS_HOST=rstar2-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=${REDIS_PASSWORD}

# Security Configuration
EXECUTION_SANDBOX=true
NETWORK_ISOLATION=true
RESOURCE_LIMITS=true

# API Configuration
API_KEY=${RSTAR_API_KEY}
MAX_REQUESTS_PER_MINUTE=60
ENABLE_LOGGING=true
LOG_LEVEL=INFO

# Integration Configuration
N8N_WEBHOOK_URL=${N8N_WEBHOOK_URL}
ENABLE_N8N_INTEGRATION=false
