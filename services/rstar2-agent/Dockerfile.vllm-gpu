# =============================================================================
# rStar2-Agent VLLM - GPU ACCELERATED DOCKERFILE
# =============================================================================
# High-performance VLLM inference server with NVIDIA GPU acceleration
# Optimized for rStar2-Agent mathematical reasoning models

FROM nvidia/cuda:11.8.0-devel-ubuntu22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    curl \
    git \
    libssl-dev \
    libffi-dev \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Set Python environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV CUDA_VISIBLE_DEVICES=all
ENV TORCH_CUDA_ARCH_LIST="6.0;6.1;7.0;7.5;8.0;8.6;8.9;9.0"

# Install Python dependencies
COPY requirements-vllm-gpu.txt .
RUN python3 -m pip install --upgrade --no-cache-dir pip setuptools wheel \
    && pip3 install --no-cache-dir -r requirements-vllm-gpu.txt

# Install PyTorch with CUDA support
RUN pip3 install --no-cache-dir \
    torch==2.1.0+cu118 \
    torchvision==0.16.0+cu118 \
    torchaudio==2.1.0+cu118 \
    --index-url https://download.pytorch.org/whl/cu118

# Install VLLM with GPU support (version compatible with torch 2.1.0)
RUN pip3 install --no-cache-dir vllm==0.2.6

# Install additional optimization libraries pinned to avoid torch upgrades
# flash-attn often needs building from source; skip to keep image stable
RUN pip3 install --no-cache-dir \
    xformers==0.0.22.post7 \
    bitsandbytes==0.41.1 \
    accelerate==0.24.1 \
    transformers==4.36.2 \
    tokenizers==0.15.0

# Copy application code
COPY src/ ./src/
COPY config/ ./config/

# Create necessary directories
RUN mkdir -p /app/models /app/cache /app/logs

# Set permissions
RUN chmod -R 755 /app/src
RUN chmod -R 777 /app/models /app/cache /app/logs

# Create non-root user
RUN useradd -m -u 1000 vllm && \
    chown -R vllm:vllm /app

USER vllm

# Environment variables for VLLM optimization
ENV VLLM_ATTENTION_BACKEND=FLASHINFER
ENV VLLM_USE_MODELSCOPE=false
ENV VLLM_WORKER_MULTIPROC_METHOD=spawn
ENV CUDA_LAUNCH_BLOCKING=0

# Health check
HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Start command with optimized VLLM settings
CMD ["python3", "-m", "vllm.entrypoints.openai.api_server", \
     "--model", "/app/models/rStar-Math-7B", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--tensor-parallel-size", "1", \
     "--gpu-memory-utilization", "0.9", \
     "--max-model-len", "4096", \
     "--swap-space", "4", \
     "--disable-log-requests"]
