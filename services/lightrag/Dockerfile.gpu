# =============================================================================
# LIGHTRAG - GPU ACCELERATED DOCKERFILE
# =============================================================================
# High-performance graph-based RAG with NVIDIA GPU acceleration
# Optimized for large-scale knowledge graph processing

FROM nvidia/cuda:11.8.0-devel-ubuntu22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    curl \
    git \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Ensure modern packaging tooling to avoid sdist metadata issues
RUN python3 -m pip install --upgrade pip setuptools wheel

# Set working directory
WORKDIR /app

# Set Python environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV CUDA_VISIBLE_DEVICES=all
ENV TORCH_CUDA_ARCH_LIST="6.0;6.1;7.0;7.5;8.0;8.6"

# Install Python dependencies
COPY requirements-gpu.txt .
RUN pip3 install --no-cache-dir -r requirements-gpu.txt

# Install PyTorch with CUDA support
RUN pip3 install --no-cache-dir \
    torch==2.1.0+cu118 \
    torchvision==0.16.0+cu118 \
    torchaudio==2.1.0+cu118 \
    --index-url https://download.pytorch.org/whl/cu118

# Install GPU-accelerated ML libraries (pinned to be compatible with torch 2.1.0+cu118)
RUN pip3 install --no-cache-dir \
    transformers==4.36.2 \
    sentence-transformers==2.2.2 \
    accelerate==0.24.1 \
    optimum==1.16.1 \
    xformers==0.0.22.post7

# Install LightRAG (assuming it's available via pip or git)
RUN pip3 install --no-cache-dir lightrag

# Copy application code
COPY src/ ./src/
COPY config/ ./config/

# Create necessary directories
RUN mkdir -p /app/data /app/models /app/cache /app/logs /app/graphs

# Set permissions
RUN chmod -R 755 /app/src
RUN chmod -R 777 /app/data /app/models /app/cache /app/logs /app/graphs

# Create non-root user
RUN useradd -m -u 1000 lightrag && \
    chown -R lightrag:lightrag /app

USER lightrag

# Environment variables for GPU optimization
ENV USE_GPU=true
ENV GPU_MEMORY_FRACTION=0.7
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:256

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Start command
CMD ["python3", "src/main.py"]
