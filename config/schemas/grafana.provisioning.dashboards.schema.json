{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grafana provisioning: dashboards.yaml (minimal)",
  "type": "object",
  "properties": {
    "apiVersion": { "type": "integer", "enum": [1] },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "orgId": { "type": "integer" },
          "folder": { "type": "string" },
          "type": { "type": "string", "enum": ["file"] },
          "options": {
            "type": "object",
            "properties": { "path": { "type": "string" } },
            "required": ["path"],
            "additionalProperties": true
          }
        },
        "required": ["name", "type", "options"],
        "additionalProperties": true
      }
    }
  },
  "required": ["apiVersion", "providers"],
  "additionalProperties": true
}
