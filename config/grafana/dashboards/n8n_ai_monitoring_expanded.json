{
  "uid": "n8n_ai_monitoring_expanded",
  "title": "N8N AI Monitoring - Expanded",
  "schemaVersion": 27,
  "version": 1,
  "panels": [
    {
      "type": "text",
      "title": "Overview",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 2},
      "options": {"content": "Expanded monitoring: blackbox probe success, service uptime (up), node exporter basic metrics"}
    },
    {
      "type": "graph",
      "title": "Blackbox probe_success (per instance)",
      "gridPos": {"x": 0, "y": 2, "w": 12, "h": 8},
      "targets": [
        {"expr": "probe_success{job=\"blackbox\"}", "legendFormat": "{{instance}}", "refId": "A"}
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "Service uptime (up)",
      "gridPos": {"x": 12, "y": 2, "w": 12, "h": 8},
      "targets": [
        {"expr": "up{job=~\"ollama|n8n|qdrant|traefik\"}", "legendFormat": "{{job}} @ {{instance}}", "refId": "A"}
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "Node exporter - load1",
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 6},
      "targets": [
        {"expr": "node_load1", "legendFormat": "{{instance}}", "refId": "A"}
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "Node exporter - memory used %",
      "gridPos": {"x": 12, "y": 10, "w": 12, "h": 6},
      "targets": [
        {"expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "{{instance}}", "refId": "A"}
      ],
      "datasource": "Prometheus"
    }
  ]
}
