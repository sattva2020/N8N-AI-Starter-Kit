# =============================================
# N8N AI Starter Kit - Конфигурация окружения
# =============================================
# Файл шаблона для создания .env файла
# Скопируйте этот файл в .env и измените значения по необходимости

# ---- БАЗОВЫЕ НАСТРОЙКИ ----
DOMAIN_NAME=example.local

# ---- POSTGRESQL ----
# Main Database для n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me_securely
POSTGRES_DB=n8n
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- N8N НАСТРОЙКИ ----
N8N_ENCRYPTION_KEY=please_replace_with_32_char_random_key
N8N_USER_MANAGEMENT_JWT_SECRET=please_replace_with_min_32_char_secret
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_HOST=n8n.${DOMAIN_NAME}
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
WEBHOOK_URL=http://${N8N_HOST}/
N8N_API_KEY=please_replace_with_n8n_api_key
N8N_API_AUTH_ACTIVE=true


# ---- ДОМЕНЫ ДЛЯ DEVELOPMENT ----
N8N_DOMAIN=n8n.${DOMAIN_NAME}
WEB_INTERFACE_DOMAIN=web.${DOMAIN_NAME}
DOCUMENT_PROCESSOR_DOMAIN=doc-processor.${DOMAIN_NAME}
QDRANT_DOMAIN=qdrant.${DOMAIN_NAME}
OLLAMA_DOMAIN=ollama.${DOMAIN_NAME}
TRAEFIK_DASHBOARD_DOMAIN=traefik.${DOMAIN_NAME}

# ---- OLLAMA НАСТРОЙКИ ----
MODELS=llama3.2:1b,qwen2.5:3b
MODEL=llama3.2:1b

# ---- СИСТЕМНЫЕ НАСТРОЙКИ ----
GENERIC_TIMEZONE=UTC
NODE_ENV=production
COMPOSE_PROJECT_NAME=n8n-ai-starter-kit

# ---- PGADMIN НАСТРОЙКИ ----
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=change_me_securely

# ---- TRAEFIK НАСТРОЙКИ ----
ACME_EMAIL=admin@example.local
TRAEFIK_USERNAME=admin
TRAEFIK_PASSWORD_HASHED=$apr1$example$examplehashhere

# ---- GRAPHITI НАСТРОЙКИ ----
# Graphiti - официальная замена для архивированного Zep Community Edition
OPENAI_API_KEY=
GRAPHITI_DOMAIN=graphiti.${DOMAIN_NAME}

# ---- NEO4J НАСТРОЙКИ (для Graphiti) ----
NEO4J_URI=bolt://neo4j-graphiti:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_securely
NEO4J_HOST=neo4j-graphiti
NEO4J_PORT=7687
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# ---- ДОМЕНЫ (для production) ----
# Production domains (override if needed)
N8N_DOMAIN=n8n.${DOMAIN_NAME}
OLLAMA_DOMAIN=ollama.${DOMAIN_NAME}
QDRANT_DOMAIN=qdrant.${DOMAIN_NAME}
PGADMIN_DOMAIN=pgadmin.${DOMAIN_NAME}
JUPYTER_DOMAIN=jupyter.${DOMAIN_NAME}
TRAEFIK_DASHBOARD_DOMAIN=traefik.${DOMAIN_NAME}
GRAPHITI_DOMAIN=graphiti.${DOMAIN_NAME}
DOCUMENT_PROCESSOR_DOMAIN=doc-processor.${DOMAIN_NAME}
WEB_INTERFACE_DOMAIN=web.${DOMAIN_NAME}

# ---- DOCUMENT PROCESSOR НАСТРОЙКИ ----
DOCUMENT_PROCESSOR_MAX_FILE_SIZE=100MB
DOCUMENT_PROCESSOR_SUPPORTED_FORMATS=pdf,docx,txt,md,rtf
DOCUMENT_PROCESSOR_CHUNK_SIZE=512
DOCUMENT_PROCESSOR_OVERLAP=50
DOCUMENT_PROCESSOR_TIMEOUT=300

# ---- ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ----
# Настройки безопасности
N8N_SECURE_COOKIE=false
N8N_METRICS=true

# Настройки базы данных
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}

# N8N reset behavior (default false in compose)
N8N_RESET=false

# Workflows Documentation Domain
WORKFLOWS_DOC_DOMAIN=workflows.${DOMAIN_NAME}
# Workflows Manager Domain
WORKFLOWS_MANAGER_DOMAIN=workflows-manager.${DOMAIN_NAME}
