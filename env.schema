# Environment schema for N8N AI Starter Kit
# Подробные подсказки ниже в стиле `.env.example` — описывают что заменить
# или как сгенерировать значение. Значения, содержащие `change_` или
# `your_` — обязательно замените перед продакшеном.
#
# Использование:
# - Запускайте `scripts/setup.sh` для генерации `.env` на основе `env.schema`.
# - Генерируйте секреты командой: `openssl rand -base64 32` (или 48 для JWT).
# - Никогда не коммитьте реальные ключи/пароли в репозиторий.

# ---- BASE SETTINGS ----
# Primary domain used to compose other service hostnames.
# Пример: example.com
DOMAIN_NAME=example.com

# ---- POSTGRESQL ----
# Postgres для n8n и связанных сервисов.
# POSTGRES_PASSWORD: замените на надёжный пароль (openssl rand -base64 24)
POSTGRES_USER=n8n
# POSTGRES_PASSWORD=change_this_secure_password_123 # Замените на надежный пароль
POSTGRES_DB=n8n
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- N8N SETTINGS ----
# N8N_ENCRYPTION_KEY: 32+ знаков, используйте openssl rand -base64 32
# N8N_ENCRYPTION_KEY=your_32_char_encryption_key_here_ # Замените на сгенерированный ключ
# JWT для управления пользователями (рекомендуется 32+ байт): openssl rand -base64 48
# N8N_USER_MANAGEMENT_JWT_SECRET=your_jwt_secret_key_here_min_32_chars # Замените на сгенерированный ключ
N8N_DEFAULT_BINARY_DATA_MODE=filesystem # filesystem или database
# Хост и порт n8n; обычно N8N_HOST = n8n.${DOMAIN_NAME}
N8N_HOST=n8n.${DOMAIN_NAME}
N8N_PORT=5678
N8N_PROTOCOL=http
# Установите true для secure cookie если используете HTTPS
N8N_SECURE_COOKIE=false
WEBHOOK_URL=http://${N8N_HOST}/ # Вебхуки n8n будут доступны по этому URL
# N8N_API_KEY=your_n8n_api_key_here # Секрет для доступа к API n8n
N8N_API_AUTH_ACTIVE=true
# N8N_ADMIN_TOKEN: personal/admin token used for automation and REST API calls.
# Сгенерируйте или создайте Personal Access Token в UI n8n и поместите сюда.
# Пример: N8N_ADMIN_TOKEN=PASTE_ADMIN_TOKEN_HERE


# Host used for local readiness probes. Defaults to loopback so healthchecks
# and startup scripts can probe the application inside the host/container
# without depending on external DNS/Traefik routing.
# N8N_PROBE_HOST=127.0.0.1

# Time in seconds start.sh will wait for n8n to become ready before skipping
# importer. Increase for slow environments (default 300).
# N8N_READY_TIMEOUT=300

# ---- DOMAINS FOR DEVELOPMENT ----
# Локальные/тестовые домены, используемые compose
N8N_DOMAIN=n8n.${DOMAIN_NAME}
WEB_INTERFACE_DOMAIN=web.${DOMAIN_NAME}
DOCUMENT_PROCESSOR_DOMAIN=doc-processor.${DOMAIN_NAME}
QDRANT_DOMAIN=qdrant.${DOMAIN_NAME}
OLLAMA_DOMAIN=ollama.${DOMAIN_NAME}
TRAEFIK_DASHBOARD_DOMAIN=traefik.${DOMAIN_NAME}
PGADMIN_DOMAIN=pgadmin.${DOMAIN_NAME}
JUPYTER_DOMAIN=jupyter.${DOMAIN_NAME}

# ---- OLLAMA SETTINGS ----
# OLLAMA_HOST: имя сервиса внутри docker-compose
OLLAMA_HOST=ollama

# ---- SYSTEM SETTINGS ----
GENERIC_TIMEZONE=UTC
NODE_ENV=production
COMPOSE_PROJECT_NAME=n8n-ai-starter-kit

# ---- PGADMIN ----
# Электронная почта и пароль для доступа к pgAdmin UI
# PGADMIN_DEFAULT_EMAIL=change_me@example.com # Замените на ваш email
# PGADMIN_DEFAULT_PASSWORD=pgadmin_secure_password_123 # Замените на надёжный пароль

# ---- TRAEFIK ----
# ACME_EMAIL используется для регистрации Let's Encrypt
# ACME_EMAIL=change_me@example.com # Замените на реальный email
TRAEFIK_USERNAME=admin
# TRAEFIK_PASSWORD_HASHED: используйте htpasswd для генерации ($ htpasswd -nb user password)
# TRAEFIK_PASSWORD_HASHED=traefik_password_hash_placeholder # Замените на htpasswd-хеш

# ---- MONITORING & ANALYTICS ----
# Grafana configuration
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin123 # Замените на надёжный пароль

# ClickHouse для аналитики
# CLICKHOUSE_PASSWORD=clickhouse_pass_2024 # Замените на надёжный пароль

# Superset для BI dashboards
# SUPERSET_SECRET_KEY=your_superset_secret_key # Замените на сгенерированный ключ

# N8N API key для мониторинга и автоматизации
# N8N_API_KEY=your_n8n_api_key_here # Секрет для доступа к API n8n

# ---- GRAPHITI / OPENAI ----
# OPENAI_API_KEY: нужен только если используете OpenAI или соответствующие провайдеры
# OPENAI_API_KEY=your_openai_api_key_here # Замените на ваш ключ API
GRAPHITI_DOMAIN=graphiti.${DOMAIN_NAME}

# ---- NEO4J ----
# Пароль Neo4j: замените на безопасный (openssl rand -base64 24)
NEO4J_URI=bolt://neo4j-graphiti:7687
NEO4J_USER=neo4j
# NEO4J_PASSWORD=change_this_secure_password_123 # Замените на надёжный пароль
NEO4J_HOST=neo4j-graphiti
NEO4J_PORT=7687
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# ---- PRODUCTION DOMAINS ----
# Повторные объявления хостнеймов удалены (оставлены первые определения выше).
# Если нужная служба требует отдельного объявления — добавьте её явно.

# ---- DOCUMENT PROCESSOR ----
# Максимальный размер файла для обработки (пример: 100MB)
DOCUMENT_PROCESSOR_MAX_FILE_SIZE=100MB
DOCUMENT_PROCESSOR_SUPPORTED_FORMATS=pdf,docx,txt,md,rtf
DOCUMENT_PROCESSOR_CHUNK_SIZE=512
DOCUMENT_PROCESSOR_OVERLAP=50
DOCUMENT_PROCESSOR_TIMEOUT=300

# ---- ADDITIONAL SETTINGS ----
N8N_SECURE_COOKIE=false
N8N_METRICS=true

# Database abstraction settings (used by some components)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD} # Проксирует основной пароль Postgres

# N8N reset behavior (default false in compose)
N8N_RESET=false

# Workflows Documentation Domain
WORKFLOWS_DOC_DOMAIN=workflows.${DOMAIN_NAME}
WORKFLOWS_MANAGER_DOMAIN=workflows-manager.${DOMAIN_NAME}
# WORKFLOWS_MANAGER_API_KEY=

# ---- LIGHTRAG / RAG SERVICE ----
# LightRAG is an optional RAG backend / API service. These variables allow
# integration with Traefik, Qdrant and protect access via API key / token.
# LIGHRAG_DOMAIN: domain/host used by Traefik to route to LightRAG (example: lightrag.example.com)
LIGHRAG_DOMAIN=lightrag.${DOMAIN_NAME}
# Server port exposed on the host (container listens on 9621 by default)
LIGHRAG_PORT=9621
# Qdrant URL when using the qdrant service from this stack
QDRANT_URL=http://qdrant:6333
# LIGHTRAG_API_KEY: client API key to authenticate requests to LightRAG
# TOKEN_SECRET: secret used to sign/verify JWTs (if LightRAG issues tokens)
# Both should be generated securely (openssl rand -base64 32 or better) and
# must NOT be committed to source control.
LIGHTRAG_API_KEY=change_this_to_a_strong_api_key
TOKEN_SECRET=change_this_to_a_strong_token_secret
# Allow anonymous access to LightRAG API (false recommended for production)
ALLOW_ANONYMOUS_ACCESS=false

# ---- DEFAULTS / SUGGESTIONS ----
# Значения ниже подходят для локальной разработки и тестов.
# Замените их перед использованием в продакшене.

# Grafana defaults (change in production)
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin123

# Jupyter
# Раскомментируйте и задайте значение, если используете JupyterLab.
# Генерация для non-interactive режима: setup.sh автоматически создает JUPYTER_TOKEN
# JUPYTER_TOKEN=your_jupyter_token_here # Раскомментируйте и задайте токен при необходимости
JUPYTER_TOKEN=

# Clickhouse (optional)
# CLICKHOUSE_PASSWORD=change_me

# Superset
# SUPERSET_SECRET_KEY=change_me

# n8n task runners
N8N_RUNNERS_ENABLED=true

# Важно: после генерации `.env` замените все плейсхолдеры (OPENAI_API_KEY, N8N_API_KEY,
# POSTGRES_PASSWORD, NEO4J_PASSWORD и т.д.) на реальные значения и не коммитьте их.
